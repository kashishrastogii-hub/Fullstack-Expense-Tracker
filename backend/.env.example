# Copy to backend/.env and fill in the values you need.
# The backend loads this file automatically (spring.config.import), but environment
# variables always take precedence.

# --- Database ---------------------------------------------------------------
DB_URL=jdbc:mysql://localhost:3306/expense_tracker
DB_USERNAME=root
# Empty for a default local MySQL install; use "root" if you started docker-compose.yml
DB_PASSWORD=

# --- Security ---------------------------------------------------------------
# Required in production (at least 32 chars). Generate with: openssl rand -base64 48
JWT_SECRET=change-this-to-a-strong-secret
JWT_EXPIRATION_MS=86400000

# --- Mail -------------------------------------------------------------------
# auto    = send when MAIL_USERNAME/MAIL_PASSWORD are set, otherwise log the code (dev default)
# console = never send, always log (development only; refused in the prod profile)
# smtp    = always send and fail loudly if delivery fails (production)
MAIL_MODE=auto
MAIL_FROM=
MAIL_SENDER_NAME=PocketWise
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# --- App --------------------------------------------------------------------
VERIFICATION_CODE_EXPIRATION_MS=900000
CORS_ALLOWED_ORIGINS=http://localhost:3000
USER_PROFILE_UPLOAD_DIR=./uploads/user/profile
# PORT=8080
